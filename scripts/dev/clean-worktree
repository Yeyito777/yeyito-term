#!/usr/bin/env bash
# clean-worktree — remove an st worktree, delete its branch, and clean local runtime/build leftovers.
#
# Usage:
#   clean-worktree <worktree-name|path>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./worktree-common.sh
source "$SCRIPT_DIR/worktree-common.sh"

INPUT="${1:-}"
WORKTREE_DIR="$(resolve_worktree_dir "$INPUT")"
[[ "$WORKTREE_DIR" != "$ST_ROOT" ]] || worktree_die "Refusing to clean the primary checkout: $ST_ROOT"
WT_NAME="$(basename "$WORKTREE_DIR")"
BRANCH=""
REGISTERED=0

LIVE_PROCESSES="$(processes_using_worktree "$WORKTREE_DIR")"
if [[ -n "$LIVE_PROCESSES" ]]; then
  worktree_die "Worktree is still in use by running process(es):
$LIVE_PROCESSES
Close them, then rerun clean-worktree."
fi

if git -C "$ST_ROOT" worktree list --porcelain | grep -Fqx "worktree $WORKTREE_DIR"; then
  REGISTERED=1
  BRANCH="$(registered_worktree_branch "$WORKTREE_DIR")"

  cleanup_worktree_runtime "$WORKTREE_DIR"
  clean_ignored_build_outputs "$WORKTREE_DIR"
  git -C "$ST_ROOT" worktree remove "$WORKTREE_DIR"
fi

if [[ -z "$BRANCH" && "$WT_NAME" != "main" ]] && git -C "$ST_ROOT" show-ref --verify --quiet "refs/heads/$WT_NAME"; then
  BRANCH="$WT_NAME"
fi

if [[ -n "$BRANCH" ]] && git -C "$ST_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git -C "$ST_ROOT" branch -d "$BRANCH"
fi

cleanup_worktree_runtime "$WORKTREE_DIR"

if [[ $REGISTERED -eq 0 || ! -e "$WORKTREE_DIR/.git" ]]; then
  rmdir "$WORKTREE_DIR" 2>/dev/null || true
fi

cat <<EOF

  ✓ Cleaned worktree
  name:   $WT_NAME
  path:   $WORKTREE_DIR
  branch: ${BRANCH:-$WT_NAME}

EOF
